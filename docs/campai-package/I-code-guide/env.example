# AI note: Template for environment variables. Contains NO secrets and must never contain any. Copy to .env.example at the repository root.
# Owner: Claude Code. Bolt reads it for variable names only.

# ---------------------------------------------------------------------------
# BROWSER (Vite bundles every VITE_* variable into the public JavaScript)
# Set these in Bolt → project settings → Environment variables, and in .env.local for local dev.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# If Bolt's Supabase integration injected the legacy name instead, the app also accepts:
# VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# EDGE FUNCTION SECRETS (never VITE_, never in the browser, never in Git)
# Production: supabase secrets set --env-file ./supabase/.env.production
# Local:      put the same lines in supabase/functions/.env (git-ignored)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...                # OpenAI Dashboard → API keys (project-scoped)
# OPENAI_MODEL=gpt-6-sol               # generate + revise
# OPENAI_MODEL_LIGHT=gpt-6-luna        # brief_check
# AI_DAILY_LIMIT_PER_USER=25           # per-user daily cap on AI calls

# Injected by Supabase into Edge Functions automatically (do not set):
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SECRET_KEY
